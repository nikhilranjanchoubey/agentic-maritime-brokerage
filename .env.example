# Agentic Maritime Brokerage Platform Environment Configuration

# Application
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=replace-with-your-strong-cryptographic-secret-key-32-chars-min
JWT_EXPIRATION_SECONDS=604800

# Optional Email / Notification Service (For Production OTP / Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=no-reply@agenticmaritime.com
